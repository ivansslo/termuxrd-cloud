# Copy to ~/.cloud_env, fill in your real values, then:
#
#   chmod 600 ~/.cloud_env
#   source ~/.cloud_env
#
# Never commit the filled-in file. .gitignore already excludes .env and
# *.env, but the safest habit is to keep it outside the repository.

# ---------------------------------------------------------------------
# Connection
# ---------------------------------------------------------------------

# Your VM's Tailscale address. Safe to share: 100.64.0.0/10 is private.
VM_TAILNET_IP="100.x.y.z"

# Login user: ubuntu (Ubuntu), opc (Oracle Linux), ec2-user (Amazon Linux)
VM_USER="ubuntu"

# What the Docker client talks to.
DOCKER_HOST="ssh://${VM_USER}@${VM_TAILNET_IP}"

# ---------------------------------------------------------------------
# Oracle Cloud — only if you use the OCI CLI
# ---------------------------------------------------------------------
#
# These OCIDs and the fingerprint identify your account. They cannot
# authenticate without the private key, but treat them as sensitive:
# they tell an attacker exactly what to target.
#
# The real secret is the .pem private key. Keep it at ~/.oci/ with
# mode 600 and never put it in a repository.

# OCI_USER="ocid1.user.oc1..REPLACE_ME"
# OCI_TENANCY="ocid1.tenancy.oc1..REPLACE_ME"
# OCI_FINGERPRINT="aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
# OCI_REGION="ap-singapore-1"
# OCI_KEY_FILE="$HOME/.oci/oci_api_key.pem"
# OCI_COMPARTMENT="ocid1.compartment.oc1..REPLACE_ME"
# OCI_SUBNET="ocid1.subnet.oc1.REGION.REPLACE_ME"

# ---------------------------------------------------------------------
# AWS — prefer an instance role over static keys
# ---------------------------------------------------------------------
#
# With an IAM role attached to the instance there are no keys to store
# or leak. Verify with: aws sts get-caller-identity

# AWS_REGION="ap-southeast-1"
# AWS_PROFILE="default"

# ---------------------------------------------------------------------
# Tailscale
# ---------------------------------------------------------------------
#
# An auth key is a password. Use an ephemeral key for disposable hosts
# so the node removes itself when it goes offline. Revoke in
# Admin console -> Settings -> Keys.

# TS_AUTHKEY="tskey-auth-REPLACE_ME"
